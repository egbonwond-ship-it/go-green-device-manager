{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/js/*",
      "/*.css",
      "/*.svg",
      "/api/*"
    ]
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/api/devices",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/agent/*",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'"
  },
  "mimeTypes": {
    ".js": "text/javascript"
  }
}
